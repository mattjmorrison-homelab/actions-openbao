#!/usr/bin/env bash

if [[ -n "${CURL_CALL_LOG:-}" ]]; then
  echo "$*" >> "$CURL_CALL_LOG"
fi

args="$*"
case "$args" in
  *"audience=openbao"*)
    echo '{"value":"fake-oidc-jwt"}'
    ;;
  *"auth/jwt/login"*)
    if [ "${MOCK_LOGIN_FAILS:-false}" = "true" ]; then
      echo '{"errors":["permission denied"]}'
    else
      echo '{"auth":{"client_token":"fake-client-token"}}'
    fi
    ;;
  *"ssh/sign/"*)
    if [ "${MOCK_SIGN_FAILS:-false}" = "true" ]; then
      echo '{"errors":["permission denied"]}'
    else
      jq -n --arg k "${MOCK_SIGNED_KEY:-fake-signed-cert}" '{data:{signed_key:$k}}'
    fi
    ;;
  *)
    echo "unexpected curl call: $args" >&2
    exit 1
    ;;
esac
